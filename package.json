{
  "name": "pentaskill-next",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "精五門 Pentaskill 新版：第一階段互動驗收原型",
  "scripts": {
    "dev": "node scripts/preview-cloud.mjs",
    "start": "node scripts/preview-cloud.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "account:create": "node scripts/create-account.mjs",
    "account:role": "node scripts/set-role.mjs",
    "cloud:dev": "wrangler dev",
    "cloud:deploy": "npm run build && wrangler deploy",
    "members:export": "node scripts/migrate-members.mjs export",
    "members:verify": "node scripts/migrate-members.mjs verify",
    "dev:sqlite": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "4.155.0"
  }
}
